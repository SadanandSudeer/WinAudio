<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinAudio</AssemblyName>
    <RootNamespace>WinAudio.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Company>WinAudio</Company>
    <Product>WinAudio Sound Controller</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Presets\default_presets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\WinAudioEngine.dll" Condition="Exists('..\..\build\WinAudioEngine.dll')" Link="WinAudioEngine.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
