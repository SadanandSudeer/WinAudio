<Window x:Class="WinAudio.App.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Deactivated="OnDeactivated">

    <Border Background="#131823" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock Text="WinAudio" FontSize="15" FontWeight="Bold" />
                </StackPanel>
                <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                          Style="{StaticResource PillToggle}"
                          IsChecked="{Binding GlobalBypass, Converter={x:Null}}"
                          x:Name="BypassCheck"
                          Content="Bypass" FontSize="12" />
            </DockPanel>

            <!-- Routing Mode Pill -->
            <Border Background="#1E2534" CornerRadius="6" Padding="8,5" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding RoutingModeBadge}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding CpuText}" FontSize="11" Foreground="#94A3B8" />
                </DockPanel>
            </Border>

            <!-- Quick Preset Switcher -->
            <TextBlock Text="ACTIVE PRESET" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4" />
            <ComboBox x:Name="FlyoutPresetBox" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                      SelectionChanged="OnPresetChanged" Margin="0,0,0,12" />

            <!-- Quick Output Device Switcher -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="OUTPUT DEVICE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}"
                          IsChecked="{Binding MultiDeviceEnabled}" Content="Multi-Out" FontSize="11" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding PhysicalDevices}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnDeviceCardClick" Tag="{Binding Id}" Margin="0,2" Padding="10,7"
                                HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButton}">
                            <DockPanel>
                                <TextBlock Text="{Binding TransportIcon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock DockPanel.Dock="Right" Text="DEFAULT" FontSize="9" FontWeight="Bold" Foreground="#10B981"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TransportBadge}" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick Sound Booster Slider -->
            <DockPanel Margin="0,0,0,2">
                <TextBlock Text="CONTROLLED SOUND BOOSTER" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Text="{Binding MaximizerBoostDb, StringFormat=+{0:0.0} dB}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
            </DockPanel>
            <Slider Minimum="0" Maximum="18" Value="{Binding MaximizerBoostDb}" Margin="0,0,0,14" />

            <!-- Footer Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Open WinAudio" Style="{StaticResource AccentButton}" Click="OnOpenMain" />
                <Button Grid.Column="2" Content="Exit" Style="{StaticResource SecondaryButton}" Click="OnExit" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
