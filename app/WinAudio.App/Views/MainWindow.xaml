<Window x:Class="WinAudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinAudio.App.Controls"
        Title="WinAudio — Windows Sound Controller"
        Width="1160" Height="760" MinWidth="980" MinHeight="660"
        Background="{StaticResource BgCanvasBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        StateChanged="OnWindowStateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP COMMAND BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#162235" BorderBrush="#38BDF8" BorderThickness="1.2" Margin="0,0,10,0">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#38BDF8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinAudio" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding RoutingModeBadge}" FontSize="10.5" Foreground="#38BDF8" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Quick Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CPU / Sample Rate Telemetry -->
                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CpuText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Border>

                    <!-- Active Output Pill -->
                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0" MaxWidth="220">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ActiveOutputSummary}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Quick Preset Dropdown -->
                    <ComboBox x:Name="TopPresetCombo" Width="190" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                              SelectionChanged="OnTopPresetSelectionChanged" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Quick Bypass Toggle -->
                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="16" Padding="10,4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding GlobalBypass}" Content="Bypass" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Center Auto-Profile Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#162032" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock FontSize="11" Foreground="#94A3B8">
                            <Run Text="Profile Source: " />
                            <Run Text="{Binding ActiveAutoProfileStatus, Mode=OneWay}" Foreground="#E2E8F0" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY: LEFT NAV RAIL + MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="6,14">
                <DockPanel>
                    <!-- Bottom Quick Utility -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,6">
                        <Border Background="#161E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="OUTPUT LEVEL &amp; LIMITER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="L" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <controls:LevelMeterControl Grid.Column="1" Height="7" LevelDb="{Binding OutPeakL}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="R" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <controls:LevelMeterControl Grid.Column="1" Height="7" LevelDb="{Binding OutPeakR}" />
                                </Grid>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Limiter GR" FontSize="10" Foreground="#F59E0B" />
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LimiterGrText}" FontSize="10" Foreground="#F59E0B" />
                                </DockPanel>
                                <controls:LevelMeterControl Height="6" LevelDb="{Binding LimiterGrDb}" IsGainReduction="True" />
                            </StackPanel>
                        </Border>
                        <Button Content="Exit &amp; Restore Audio" Style="{StaticResource SecondaryButton}" FontSize="11.5" Click="OnExitClick" />
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavRailItem}" IsChecked="True" Checked="OnNavChecked" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavEq" Style="{StaticResource NavRailItem}" Checked="OnNavChecked" Tag="Equalizer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Equalizer" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSpatial" Style="{StaticResource NavRailItem}" Checked="OnNavChecked" Tag="Spatial">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Spatial &amp; Dynamics" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavOutputs" Style="{StaticResource NavRailItem}" Checked="OnNavChecked" Tag="Outputs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Outputs &amp; Multi-Device" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProfiles" Style="{StaticResource NavRailItem}" Checked="OnNavChecked" Tag="Profiles">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Presets &amp; Profiles" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavRailItem}" Checked="OnNavChecked" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings &amp; Setup" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <Grid>
                    <!-- ==================== 1. DASHBOARD ==================== -->
                    <StackPanel x:Name="PanelDashboard" Visibility="Visible">
                        <!-- Routing Guidance Banner -->
                        <Border Background="#132033" BorderBrush="#264568" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Setup / Routing" Style="{StaticResource SecondaryButton}"
                                        Click="OnGoSettings" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding RoutingModeBadge}" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                    <TextBlock Text="{Binding RoutingModeDetail}" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Live Spectrum & Response Preview -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="LIVE SPECTRUM &amp; EQ RESPONSE" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding TestToneEnabled}" Content="440Hz Test Tone" FontSize="11.5" Margin="0,0,12,0" />
                                        <Button Content="Open Full EQ" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,3" Click="OnGoEq" />
                                    </StackPanel>
                                </DockPanel>
                                <controls:EqCurveCanvas x:Name="DashboardEqCanvas" Height="175" />
                            </StackPanel>
                        </Border>

                        <!-- Big Rotary Quick Controls: Bass, Treble, Clarity, Controlled Maximizer -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Bass Booster Card -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Bass Booster" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding BassEnabled}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <controls:RotaryKnob Label="Bass Gain" Minimum="0" Maximum="15" Value="{Binding BassBoostDb}" AccentColor="#38BDF8" />
                                        <controls:RotaryKnob Label="Punch Exciter" Minimum="0" Maximum="100" UnitSuffix="%" Value="{Binding BassExciterPercent}" AccentColor="#818CF8" />
                                    </StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Center Freq" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding BassFreqHz, StringFormat={}{0:0} Hz}" FontSize="11" Foreground="#CBD5E1" />
                                    </DockPanel>
                                    <Slider Minimum="60" Maximum="150" Value="{Binding BassFreqHz}" />
                                </StackPanel>
                            </Border>

                            <!-- Treble & Clarity Card -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Treble &amp; Clarity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding TrebleEnabled}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <controls:RotaryKnob Label="Treble Air" Minimum="0" Maximum="15" Value="{Binding TrebleBoostDb}" AccentColor="#10B981" />
                                        <controls:RotaryKnob Label="Vocal Clarity" Minimum="0" Maximum="8" Value="{Binding ClarityBoostDb}" AccentColor="#34D399" />
                                    </StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Air Shelf Freq" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding TrebleFreqHz, StringFormat={}{0:0} Hz}" FontSize="11" Foreground="#CBD5E1" />
                                    </DockPanel>
                                    <Slider Minimum="3500" Maximum="10000" Value="{Binding TrebleFreqHz}" />
                                </StackPanel>
                            </Border>

                            <!-- Controlled Sound Booster / Maximizer Card -->
                            <Border Grid.Column="4" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Sound Maximizer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding MaximizerEnabled}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <controls:RotaryKnob Label="Safe Boost" Minimum="0" Maximum="18" Value="{Binding MaximizerBoostDb}" AccentColor="#F59E0B" />
                                        <controls:RotaryKnob Label="Warm Clip" Minimum="0" Maximum="100" UnitSuffix="%" Value="{Binding MaximizerSoftClipPercent}" AccentColor="#FB7185" />
                                    </StackPanel>
                                    <DockPanel Margin="0,2,0,3">
                                        <TextBlock Text="Peak Limiter Protection" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LimiterGrText}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <controls:LevelMeterControl Height="8" LevelDb="{Binding LimiterGrDb}" IsGainReduction="True" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Output Switcher + Quick Spatial Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Quick Output Switcher" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Multi-Device Matrix →"
                                                Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Click="OnGoOutputs" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PhysicalDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnQuickSwitchDeviceClick" Tag="{Binding Id}" Margin="0,3" Padding="10,8"
                                                        HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButton}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding TransportIcon}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Border DockPanel.Dock="Right" Background="#0F2E26" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="DEFAULT" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="10.5" Foreground="#94A3B8">
                                                                <Run Text="{Binding TransportBadge, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding FormatText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="Quick Spatial &amp; Dynamics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding LoudnessEnabled}" Content="Loudness Normalization (AGC)" Margin="0,0,0,10" />
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding WidenerEnabled}" Content="Stereo Widener (Bass-Mono)" Margin="0,0,0,10" />
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding AmbienceEnabled}" Content="Room Ambience" Margin="0,0,0,12" />
                                    <TextBlock Text="Virtual Surround Mode" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ComboBox SelectedIndex="{Binding SurroundModeIndex}" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Off" />
                                        <ComboBoxItem Content="Headphones (Binaural ITD)" />
                                        <ComboBoxItem Content="Speakers (Soundstage)" />
                                    </ComboBox>
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding MultiDeviceEnabled}" Content="Multi-Device Simultaneous Out" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== 2. MULTI-BAND EQUALIZER ==================== -->
                    <StackPanel x:Name="PanelEqualizer" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding EqEnabled}" Content="Equalizer" FontSize="15" FontWeight="SemiBold" Margin="0,0,18,0" />
                                        <ComboBox SelectedIndex="{Binding EqModeIndex}" Width="210">
                                            <ComboBoxItem Content="10-Band Graphic (ISO Octave)" />
                                            <ComboBoxItem Content="31-Band Graphic (1/3-Octave)" />
                                            <ComboBoxItem Content="Semi-Parametric (12-Band)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Pre-Amp" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Width="110" Minimum="-18" Maximum="18" Value="{Binding PreAmpDb}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PreAmpDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" Width="56" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="6,0,10,0" />
                                        <Button Content="Flatten" Style="{StaticResource SecondaryButton}" Click="OnFlattenEqClick" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Tip: Drag nodes directly on the graph. Double-click any node to reset to 0 dB. In Parametric mode, scroll wheel adjusts Q."
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,8" />

                                <controls:EqCurveCanvas x:Name="MainEqCanvas" Height="235" />
                            </StackPanel>
                        </Border>

                        <!-- 10-Band Graphic Sliders -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource FluentCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEq10}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ItemsControl ItemsSource="{Binding Eq10Bands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding GainText}" FontSize="10.5" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <Slider Orientation="Vertical" Height="165" Minimum="-15" Maximum="15" Value="{Binding GainDb}"
                                                    TickFrequency="3" TickPlacement="Both" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 31-Band Graphic Sliders -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource FluentCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEq31}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Eq31Bands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="28" HorizontalAlignment="Center" Margin="1,0">
                                                <TextBlock Text="{Binding GainText}" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <Slider Orientation="Vertical" Height="160" Minimum="-15" Maximum="15" Value="{Binding GainDb}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Semi-Parametric 12-Band Editor -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource FluentCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEqParam}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Selected Parametric Band" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <ComboBox Width="110" SelectedIndex="{Binding SelectedParamBandIndex}" Margin="0,0,14,0">
                                        <ComboBoxItem Content="Band 1" /><ComboBoxItem Content="Band 2" /><ComboBoxItem Content="Band 3" /><ComboBoxItem Content="Band 4" />
                                        <ComboBoxItem Content="Band 5" /><ComboBoxItem Content="Band 6" /><ComboBoxItem Content="Band 7" /><ComboBoxItem Content="Band 8" />
                                        <ComboBoxItem Content="Band 9" /><ComboBoxItem Content="Band 10" /><ComboBoxItem Content="Band 11" /><ComboBoxItem Content="Band 12" />
                                    </ComboBox>
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding ParamBandEnabled}" Content="Enabled" Margin="0,0,16,0" />
                                    <ComboBox Width="150" SelectedIndex="{Binding ParamBandTypeIndex}">
                                        <ComboBoxItem Content="Peaking Bell" />
                                        <ComboBoxItem Content="Low Shelf" />
                                        <ComboBoxItem Content="High Shelf" />
                                        <ComboBoxItem Content="Low Pass" />
                                        <ComboBoxItem Content="High Pass" />
                                        <ComboBoxItem Content="Notch" />
                                    </ComboBox>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel>
                                            <TextBlock Text="Frequency" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding ParamBandFreqHz, StringFormat={}{0:0} Hz}" Foreground="#38BDF8" />
                                        </DockPanel>
                                        <Slider Minimum="20" Maximum="20000" Value="{Binding ParamBandFreqHz}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock Text="Gain" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding ParamBandGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" Foreground="#10B981" />
                                        </DockPanel>
                                        <Slider Minimum="-18" Maximum="18" Value="{Binding ParamBandGainDb}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <DockPanel>
                                            <TextBlock Text="Q Factor (Bandwidth)" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding ParamBandQ, StringFormat={}{0:0.00}}" Foreground="#CBD5E1" />
                                        </DockPanel>
                                        <Slider Minimum="0.3" Maximum="12" Value="{Binding ParamBandQ}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 3. SPATIAL & DYNAMICS ==================== -->
                    <StackPanel x:Name="PanelSpatial" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Virtual Surround -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="Virtual Surround" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Binaural headphone ITD/head-shadow externalizer or desktop speaker virtualizer." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <ComboBox SelectedIndex="{Binding SurroundModeIndex}" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Off" />
                                        <ComboBoxItem Content="Headphones (Binaural Virtual Surround)" />
                                        <ComboBoxItem Content="Speakers (Wide Soundstage)" />
                                    </ComboBox>
                                    <DockPanel>
                                        <TextBlock Text="Surround Depth" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding SurroundDepthPercent, StringFormat={}{0:0}%}" Foreground="#38BDF8" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding SurroundDepthPercent}" />
                                </StackPanel>
                            </Border>

                            <!-- Stereo Widener -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Stereo Widener" FontSize="15" FontWeight="SemiBold" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding WidenerEnabled}" />
                                    </DockPanel>
                                    <TextBlock Text="Mid/Side stereo expansion with Linkwitz-Riley bass-mono preservation so bass stays tight." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <DockPanel>
                                        <TextBlock Text="Stereo Width (100% = Natural)" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding StereoWidthPercent, StringFormat={}{0:0}%}" Foreground="#10B981" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="200" Value="{Binding StereoWidthPercent}" Margin="0,0,0,10" />
                                    <DockPanel>
                                        <TextBlock Text="Bass-Mono Crossover" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding BassMonoFreqHz, StringFormat={}{0:0} Hz}" Foreground="#CBD5E1" />
                                    </DockPanel>
                                    <Slider Minimum="80" Maximum="300" Value="{Binding BassMonoFreqHz}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Room Ambience -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Room Ambience (FDN)" FontSize="15" FontWeight="SemiBold" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding AmbienceEnabled}" />
                                    </DockPanel>
                                    <TextBlock Text="4-channel Hadamard Feedback Delay Network adds natural acoustic space without muddiness." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <DockPanel>
                                        <TextBlock Text="Room Size" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding AmbienceRoomPercent, StringFormat={}{0:0}%}" />
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="100" Value="{Binding AmbienceRoomPercent}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="HF Damping" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding AmbienceDampPercent, StringFormat={}{0:0}%}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding AmbienceDampPercent}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="Wet Mix" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding AmbienceMixPercent, StringFormat={}{0:0}%}" Foreground="#38BDF8" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="60" Value="{Binding AmbienceMixPercent}" />
                                </StackPanel>
                            </Border>

                            <!-- Loudness Normalization -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Loudness Normalization" FontSize="15" FontWeight="SemiBold" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding LoudnessEnabled}" />
                                    </DockPanel>
                                    <TextBlock Text="EBU R128 K-weighted dynamic leveler with -50 LUFS silence gate keeps volume consistent across apps &amp; videos." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Live AGC Gain Applied" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LoudnessGainText}" Foreground="#10B981" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Target Loudness" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LoudnessTargetLufs, StringFormat={}{0:0.0} LUFS}" />
                                    </DockPanel>
                                    <Slider Minimum="-22" Maximum="-10" Value="{Binding LoudnessTargetLufs}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="Leveling Strength" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LoudnessStrengthPercent, StringFormat={}{0:0}%}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding LoudnessStrengthPercent}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="Max Quiet Boost Cap" FontSize="11.5" Foreground="#94A3B8" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding LoudnessMaxGainDb, StringFormat=+{0:0.0} dB}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="12" Value="{Binding LoudnessMaxGainDb}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Controlled Sound Booster / Maximizer Advanced -->
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Controlled Sound Booster &amp; 3 ms Lookahead Brickwall Limiter" FontSize="15" FontWeight="SemiBold" />
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding MaximizerEnabled}" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel>
                                            <TextBlock Text="Boost Gain" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding MaximizerBoostDb, StringFormat=+{0:0.0} dB}" Foreground="#F59E0B" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="18" Value="{Binding MaximizerBoostDb}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock Text="Peak Ceiling" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding MaximizerCeilingDb, StringFormat={}{0:0.0} dBFS}" />
                                        </DockPanel>
                                        <Slider Minimum="-3" Maximum="-0.1" Value="{Binding MaximizerCeilingDb}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <DockPanel>
                                            <TextBlock Text="Soft-Clip Warmth" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding MaximizerSoftClipPercent, StringFormat={}{0:0}%}" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding MaximizerSoftClipPercent}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <DockPanel>
                                            <TextBlock Text="Release Speed" FontSize="11.5" Foreground="#94A3B8" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding MaximizerReleaseMs, StringFormat={}{0:0} ms}" />
                                        </DockPanel>
                                        <Slider Minimum="20" Maximum="300" Value="{Binding MaximizerReleaseMs}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 4. OUTPUTS & MULTI-DEVICE ==================== -->
                    <StackPanel x:Name="PanelOutputs" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Sync Pulse Test" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OnSyncPulseClick"
                                            ToolTip="Plays a brief 1 kHz ping on all enabled outputs so you can align Wired + Bluetooth delay." />
                                    <Button Content="Refresh Devices" Style="{StaticResource SecondaryButton}" Click="OnRefreshDevicesClick" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Multi-Device Simultaneous Output" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding MultiDeviceEnabled}" Content="Enable Multi-Device Fan-Out" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="Enable any combination of Wired (3.5 mm, HDMI, USB) + multiple Bluetooth A2DP devices simultaneously. Use Sync Delay (0–500 ms) or Acoustic Mic Auto-Calibration to synchronize outputs."
                                               FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Acoustic Microphone Auto-Calibration Card (only active when a physical mic is attached!) -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,14" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Auto-Calibrate (Mic)" Style="{StaticResource AccentButton}"
                                                IsEnabled="{Binding CanCalibrateNow}" Click="OnRunMicCalibrationClick"
                                                ToolTip="Measures each enabled device with a brief chirp via your microphone and aligns Sync Delay automatically." />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Acoustic Mic Auto-Calibration" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Background="#1B2231" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MicStatusText}" FontSize="10.5" Foreground="#C4B5FD" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CalibrationStatusText}" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasMicrophone}">
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding AutoCalibrateOnDeviceAdd}"
                                              Content="Auto-calibrate whenever an additional device is enabled" FontSize="11.5" Margin="0,0,20,0" />
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding CalibrateVolumeLevel}"
                                              Content="Also balance speaker volumes during calibration" FontSize="11.5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PhysicalDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding IsMultiEnabled}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding TransportIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                            <Border Background="#132A22" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="WINDOWS DEFAULT" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                                            </Border>
                                                            <Border Background="#3B1D1D" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBluetoothHfp}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="HFP LOW BANDWIDTH — USE STEREO A2DP" FontSize="9.5" FontWeight="Bold" Foreground="#FDA4AF" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="{Binding TransportBadge, Mode=OneWay}" />
                                                            <Run Text=" • " />
                                                            <Run Text="{Binding FormatText, Mode=OneWay}" />
                                                            <Run Text=" • " />
                                                            <Run Text="{Binding HealthText, Mode=OneWay}" Foreground="#38BDF8" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding Mute}" Content="Mute" FontSize="11.5" Margin="0,0,10,0" />
                                                    <Button Content="Set Windows Default" Style="{StaticResource SecondaryButton}" FontSize="11.5"
                                                            Click="OnQuickSwitchDeviceClick" Tag="{Binding Id}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Direct Loopback info strip for the Windows Default Device -->
                                            <Border Background="#132234" BorderBrush="#264568" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectLoopbackSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Direct Mode Loopback Source: Volume, Mute &amp; L/R Balance control this Windows device directly. Install VB-CABLE (Settings) to also apply EQ/DSP &amp; Sync Delay on this primary device."
                                                           FontSize="10.5" Foreground="#7DD3FC" TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Per-Device Volume, Balance, Sync Delay -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="0.75*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <DockPanel>
                                                        <TextBlock Text="Output Volume Trim" FontSize="11" Foreground="#94A3B8" />
                                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding VolumePercentText}" FontSize="11" Foreground="#CBD5E1" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" IsEnabled="{Binding CanAdjustSyncDelay}">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock Text="Sync Delay Offset (Wired ↔ BT)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="-5" FontSize="10" Padding="5,1" Margin="0,0,2,0" Style="{StaticResource SecondaryButton}" Click="OnNudgeDelayClick" Tag="-5" />
                                                            <Button Content="-1" FontSize="10" Padding="5,1" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="OnNudgeDelayClick" Tag="-1" />
                                                            <TextBlock Text="{Binding SyncDelayText}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" />
                                                            <Button Content="+1" FontSize="10" Padding="5,1" Margin="6,0,2,0" Style="{StaticResource SecondaryButton}" Click="OnNudgeDelayClick" Tag="1" />
                                                            <Button Content="+5" FontSize="10" Padding="5,1" Style="{StaticResource SecondaryButton}" Click="OnNudgeDelayClick" Tag="5" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="500" Value="{Binding SyncDelayMs}"
                                                            ToolTip="Delay faster outputs by 1 ms steps to match slower Bluetooth speakers. (In Direct Mode, applies to secondary synced outputs; install VB-CABLE to delay the primary device too.)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <DockPanel>
                                                        <TextBlock Text="L/R Balance" FontSize="11" Foreground="#94A3B8" />
                                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Balance, StringFormat={}{0:+0.00;-0.00;Center}}" FontSize="11" Foreground="#CBD5E1" />
                                                    </DockPanel>
                                                    <Slider Minimum="-1" Maximum="1" Value="{Binding Balance}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== 5. PRESETS & PROFILES ==================== -->
                    <StackPanel x:Name="PanelProfiles" Visibility="Collapsed">
                        <!-- Preset Gallery & Save/Import -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Genre &amp; Use-Case Presets" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="NewPresetNameBox" Width="170" Margin="0,0,8,0" ToolTip="New custom preset name" />
                                        <Button Content="Save Current" Style="{StaticResource AccentButton}" Click="OnSavePresetClick" Margin="0,0,8,0" />
                                        <Button Content="Import JSON / APO" Style="{StaticResource SecondaryButton}" Click="OnImportPresetClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource SecondaryButton}" Click="OnExportPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1B2231" BorderBrush="#2D3950" BorderThickness="1" CornerRadius="8" Padding="12" Width="210" Margin="0,0,10,10">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="×" Padding="5,0" FontSize="12"
                                                                Click="OnDeletePresetClick" Tag="{Binding Id}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Height="34" Margin="0,0,0,8" />
                                                    <Button Content="Apply Preset" Style="{StaticResource SecondaryButton}" Click="OnApplyPresetCardClick" Tag="{Binding Id}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Per-App & Per-Device Auto-Profile Rules -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Per-App Auto Rules -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Per-App Auto-Profiles" FontSize="14.5" FontWeight="SemiBold" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}"
                                                  IsChecked="{Binding AutoProfileSwitchingEnabled}" Content="Auto-Switch" FontSize="11.5" />
                                    </DockPanel>
                                    <TextBlock Text="Automatically switch presets when a game, browser, media player, or voice app is active." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="AppProcessCombo" Grid.Column="0" IsEditable="True" ItemsSource="{Binding RunningApps}" ToolTip="Process name (e.g. Spotify, cs2, vlc)" />
                                        <ComboBox x:Name="AppPresetCombo" Grid.Column="2" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" />
                                        <Button Grid.Column="4" Content="+ Add" Style="{StaticResource AccentButton}" Click="OnAddAppRuleClick" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AppRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1B2231" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,3"
                                                                Click="OnRemoveAppRuleClick" Tag="{Binding}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding ProfileId, StringFormat=Preset ID: {0}}" FontSize="10.5" Foreground="#38BDF8" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Per-Device Profile Mappings -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Per-Device Auto-Profiles" FontSize="14.5" FontWeight="SemiBold" />
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}"
                                                  IsChecked="{Binding ManualProfileLock}" Content="Lock Manual" FontSize="11.5" />
                                    </DockPanel>
                                    <TextBlock Text="Bind a saved preset to each speaker, headset, or Bluetooth device so switching outputs loads its custom curve automatically." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DevMapDeviceCombo" Grid.Column="0" ItemsSource="{Binding PhysicalDevices}" DisplayMemberPath="Name" />
                                        <ComboBox x:Name="DevMapPresetCombo" Grid.Column="2" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" />
                                        <Button Grid.Column="4" Content="Bind" Style="{StaticResource AccentButton}" Click="OnBindDeviceProfileClick" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DeviceMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1B2231" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,3"
                                                                Click="OnRemoveDeviceMappingClick" Tag="{Binding}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ProfileId, StringFormat=Preset ID: {0}}" FontSize="10.5" Foreground="#10B981" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== 6. SETTINGS & SETUP ==================== -->
                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <!-- Audio Engine & Virtual Sink Setup -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Audio Routing &amp; Virtual Sink (VB-CABLE)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="WinAudio uses a WHQL-signed Virtual Audio Sink (like free VB-CABLE) for full single-device &amp; multi-device system DSP without enabling Windows Test Signing Mode (100% safe for gaming anti-cheats). Without a virtual sink, WinAudio runs in Zero-Driver Loopback mode."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding PreferVirtualSink}" Content="Prefer Virtual Sink Mode (Full System DSP)" Margin="0,0,18,0" />
                                    <Button Content="Download VB-CABLE (Official)" Style="{StaticResource AccentButton}" Click="OnOpenVbCableClick" Margin="0,0,8,0" />
                                    <Button Content="Restart Engine" Style="{StaticResource SecondaryButton}" Click="OnRestartEngineClick" />
                                </StackPanel>
                                <DockPanel MaxWidth="460" HorizontalAlignment="Left">
                                    <TextBlock Text="Engine Buffer Latency (10ms Low-Latency ↔ 60ms Multi-Bluetooth Stability)" FontSize="11.5" Foreground="#94A3B8" />
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding BufferLatencyMs, StringFormat={}{0} ms}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider Width="460" HorizontalAlignment="Left" Minimum="10" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding BufferLatencyMs}" />
                            </StackPanel>
                        </Border>

                        <!-- Opt-In Global Hotkeys -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Global Keyboard Shortcuts (Opt-In)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillToggle}"
                                              IsChecked="{Binding GlobalHotkeysMasterEnabled}" Content="Enable Global Hotkeys" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="All shortcuts start unbound so WinAudio never conflicts with VS Code, games, Discord, or browser tools. Click 'Bind' and press a modifier + key (e.g., Ctrl+Alt+F9) if desired."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding HotkeyRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1B2231" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,8,0" MinWidth="120">
                                                            <TextBlock Text="{Binding ShortcutText}" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <Button Content="Bind..." Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Margin="0,0,6,0"
                                                                Click="OnBindHotkeyClick" Tag="{Binding}" />
                                                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                                                Click="OnClearHotkeyClick" Tag="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Startup & Tray Behavior -->
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="System Tray &amp; Startup (Portable)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding StartWithWindows}" Content="Launch WinAudio automatically when Windows starts" Margin="0,0,0,10" />
                                <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding StartMinimizedToTray}" Content="Start minimized to system tray (0% UI CPU overhead)" Margin="0,0,0,10" />
                                <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding MinimizeToTrayOnClose}" Content="Minimize to system tray when clicking the window close (×) button" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
